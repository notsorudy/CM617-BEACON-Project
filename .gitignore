# environment and caches
.venv/
__pycache__/
*.pyc

# internal working notes
HANDOFF.md
repo/

# raw data (about 16.8 GB): see README for download links; only small inputs are kept
data/*
!data/ninja_pv_23.2500_69.6703_uncorrected.csv
!data/ninja_wind_23.2500_69.6703_uncorrected.csv
!data/grid_events/
data/grid_events/*
!data/grid_events/calibration_targets.csv

# large intermediate outputs (> 5 MB), regenerated by the scripts
outputs/predictions.csv
outputs/cycle_table.csv
outputs/cycle_table_with_flags.csv
outputs/real_grid_hourly.csv
outputs/real_grid_cal_hourly.csv
outputs/real_grid_cal_cases.csv
outputs/grid_india_hourly.csv
outputs/grid_india_hourly_clean.csv

# trained models: keep only the two the main chain loads
outputs/models/*
!outputs/models/sandia_m1_nodays__forest.joblib
!outputs/models/M2_soh__forest.joblib

# video media and build intermediates (regenerated by video/make_*.py)
video/*.mp4
video/*.wav
video/audio/
video/slides/
video/slides_gslides/
video/slides.txt
